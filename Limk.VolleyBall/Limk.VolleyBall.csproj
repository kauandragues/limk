<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="UserControls\**" />
    <Compile Remove="Variaveis de Ambiente\**" />
    <EmbeddedResource Remove="UserControls\**" />
    <EmbeddedResource Remove="Variaveis de Ambiente\**" />
    <None Remove="UserControls\**" />
    <None Remove="Variaveis de Ambiente\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotenv.net" Version="4.2.0" />
    <PackageReference Include="MySql.Data" Version="26.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update=".env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="User Constrols\CartaoFaseControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="User Constrols\CartaoFaseControl.Designer.cs">
      <DependentUpon>CartaoFaseControl.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="User Constrols\CartaoFaseControl.resx">
      <DependentUpon>CartaoFaseControl.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="User Constrols\CartaoTaticaInicio.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="User Constrols\CartaoTaticaInicio.Designer.cs">
      <DependentUpon>CartaoTaticaInicio.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="User Constrols\CartaoTaticaInicio.resx">
      <DependentUpon>CartaoTaticaInicio.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="User Constrols\CartaoEquipeInicio.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="User Constrols\CartaoEquipeInicio.Designer.cs">
      <DependentUpon>CartaoEquipeInicio.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="User Constrols\CartaoEquipeInicio.resx">
      <DependentUpon>CartaoEquipeInicio.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
