DadosAtletas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#F1F3F7"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«static»</FONT><BR/><B>DadosAtletas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12"><U>+ Listar(usuarioId): DataTable</U><BR ALIGN="LEFT"/><U>+ CarregarPosicoes(): List&lt;PosicaoCadastro&gt;</U><BR ALIGN="LEFT"/><U>+ Salvar(usuarioId, atleta, posicaoIds): int</U><BR ALIGN="LEFT"/><U>+ Excluir(usuarioId, atletaId, equipeId): void</U><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
