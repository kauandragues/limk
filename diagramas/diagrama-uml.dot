Tatica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>Tatica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- id: int<BR ALIGN="LEFT"/>- equipeId: int<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- descricao: string<BR ALIGN="LEFT"/>- tipoTaticaId: int?<BR ALIGN="LEFT"/>- sistemaJogoId: int?<BR ALIGN="LEFT"/>- quadros: List&lt;QuadroTatica&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Validar(): void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
QuadroTatica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>QuadroTatica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- nome: string<BR ALIGN="LEFT"/>- duracaoMs: int<BR ALIGN="LEFT"/>- rotacao: int?<BR ALIGN="LEFT"/>- atletas: List&lt;AtletaQuadro&gt;<BR ALIGN="LEFT"/>- bola: PosicaoBola?<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Copiar(): QuadroTatica<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
ElementoQuadra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«abstract»</FONT><BR/><I>ElementoQuadra</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- x: float<BR ALIGN="LEFT"/>- y: float<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ GetX(): float<BR ALIGN="LEFT"/>+ SetX(x: float): void<BR ALIGN="LEFT"/>+ GetY(): float<BR ALIGN="LEFT"/>+ SetY(y: float): void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
