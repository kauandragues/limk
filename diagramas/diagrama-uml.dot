PosicaoBola [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>PosicaoBola</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Copiar(): PosicaoBola<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
LadoAtleta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«enumeration»</FONT><BR/><B>LadoAtleta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">Principal<BR ALIGN="LEFT"/>Adversario<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
