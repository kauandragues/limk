TaticaInicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>TaticaInicio</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- id: int<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- descricao: string<BR ALIGN="LEFT"/>- equipe: string<BR ALIGN="LEFT"/>- quadros: long<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
EquipeInicio [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="245" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>EquipeInicio</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- nome: string<BR ALIGN="LEFT"/>- atletas: long<BR ALIGN="LEFT"/>- taticas: long<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
}
