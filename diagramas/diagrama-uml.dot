digraph LIMK {
graph [rankdir=LR, bgcolor="#FFFFFF", pad="0.35", nodesep="0.5", ranksep="0.8", splines=polyline, newrank=true, compound=true, outputorder=edgesfirst, fontname="Arial", fontsize=22, labelloc=t, labeljust=l, label="LIMK Volleyball — Diagrama de classes UML do sistema\nClasses principais da aplicação C# · Windows Forms · MySQL" ];
node [shape=plain, fontname="Arial"];
