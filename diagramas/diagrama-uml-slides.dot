digraph LIMK {
graph [rankdir=LR, bgcolor="#FFFFFF", pad="0.35", nodesep="0.5", ranksep="0.8", splines=polyline, newrank=true, compound=true, outputorder=edgesfirst, fontname="Arial", fontsize=22, labelloc=t, labeljust=l, label="LIMK Volleyball — Diagrama de classes UML\nNúcleo da prancheta tática · atributos e operações principais" ];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=10, labeldistance=1.5, labelangle=22];
UsuarioAutenticado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>UsuarioAutenticado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- id: int<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- email: string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
Tatica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>Tatica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- id: int<BR ALIGN="LEFT"/>- equipeId: int<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- descricao: string<BR ALIGN="LEFT"/>- tipoTaticaId: int?<BR ALIGN="LEFT"/>- sistemaJogoId: int?<BR ALIGN="LEFT"/>- quadros: List&lt;QuadroTatica&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Validar(): void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
QuadroTatica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>QuadroTatica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- nome: string<BR ALIGN="LEFT"/>- duracaoMs: int<BR ALIGN="LEFT"/>- rotacao: int?<BR ALIGN="LEFT"/>- atletas: List&lt;AtletaQuadro&gt;<BR ALIGN="LEFT"/>- bola: PosicaoBola?<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Copiar(): QuadroTatica<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
ElementoQuadra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«abstract»</FONT><BR/><I>ElementoQuadra</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- x: float<BR ALIGN="LEFT"/>- y: float<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ GetX(): float<BR ALIGN="LEFT"/>+ SetX(x: float): void<BR ALIGN="LEFT"/>+ GetY(): float<BR ALIGN="LEFT"/>+ SetY(y: float): void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
AtletaQuadro [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>AtletaQuadro</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- equipeAtletaId: int?<BR ALIGN="LEFT"/>- nome: string<BR ALIGN="LEFT"/>- numeroCamisa: int<BR ALIGN="LEFT"/>- lado: LadoAtleta<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Copiar(): AtletaQuadro<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
PosicaoBola [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><B>PosicaoBola</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ Copiar(): PosicaoBola<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
LadoAtleta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#EFE8FA"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«enumeration»</FONT><BR/><B>LadoAtleta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">Principal<BR ALIGN="LEFT"/>Adversario<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
DadosPrancheta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#F1F3F7"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«static»</FONT><BR/><B>DadosPrancheta</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12"><U>+ Listar(usuarioId): DataTable</U><BR ALIGN="LEFT"/><U>+ Carregar(usuarioId, taticaId): Tatica</U><BR ALIGN="LEFT"/><U>+ CarregarElenco(...): List&lt;AtletaDaEquipe&gt;</U><BR ALIGN="LEFT"/><U>+ Salvar(usuarioId, tatica): int</U><BR ALIGN="LEFT"/><U>+ Excluir(usuarioId, taticaId): bool</U><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
ConexaoBD [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#F1F3F7"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«static»</FONT><BR/><B>ConexaoBD</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12"><U>+ Abrir(conexao): void</U><BR ALIGN="LEFT"/><U>+ Fechar(conexao): void</U><BR ALIGN="LEFT"/><U>+ ConsultarTabela(sql, usuarioId?): DataTable</U><BR ALIGN="LEFT"/><U>+ EhFalhaDeBanco(erro): bool</U><BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
TelaPranchetaTatica [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#E8F0FB"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«UserControl»</FONT><BR/><B>TelaPranchetaTatica</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- _usuario: UsuarioAutenticado?<BR ALIGN="LEFT"/>- _tatica: Tatica<BR ALIGN="LEFT"/>- _elenco: List&lt;AtletaDaEquipe&gt;<BR ALIGN="LEFT"/>- _preferencias: PreferenciasUsuario<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ DefinirUsuario(usuario): void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
PranchetaControl [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#40384F" BGCOLOR="#FFFFFF"><TR><TD WIDTH="235" BGCOLOR="#E8F0FB"><FONT FACE="Arial" POINT-SIZE="16"><FONT POINT-SIZE="11">«Control»</FONT><BR/><B>PranchetaControl</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">- _elementos: List&lt;ElementoQuadra&gt;<BR ALIGN="LEFT"/>- _selecionado: ElementoQuadra?<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BORDER="1" SIDES="T"><FONT FACE="Arial" POINT-SIZE="12">+ GetElementos(): List&lt;ElementoQuadra&gt;<BR ALIGN="LEFT"/>+ SelecionarElemento(elemento): void<BR ALIGN="LEFT"/>~ AplicarPreferencias(preferencias): void<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
{rank=same; UsuarioAutenticado; TelaPranchetaTatica;}
{rank=same; DadosPrancheta; ConexaoBD; PranchetaControl;}
{rank=same; Tatica; QuadroTatica; ElementoQuadra;}
{rank=same; AtletaQuadro; PosicaoBola; LadoAtleta;}
UsuarioAutenticado -> DadosPrancheta -> Tatica -> AtletaQuadro [style=invis, weight=5];
TelaPranchetaTatica -> UsuarioAutenticado [style=dashed, arrowhead=open, color="#7B718C", penwidth=1.1, arrowsize=0.9, constraint=false];
TelaPranchetaTatica -> DadosPrancheta [style=dashed, arrowhead=open, color="#7B718C", penwidth=1.1, arrowsize=0.9, label="carrega / salva"];
TelaPranchetaTatica -> Tatica [arrowhead=none, color="#65557D", penwidth=1.3, arrowsize=0.9, label="edita"];
TelaPranchetaTatica -> PranchetaControl [dir=both, arrowtail=diamond, arrowhead=none, color="#40384F", penwidth=1.5, arrowsize=0.9, label="prancheta", taillabel="1", headlabel="1"];
PranchetaControl -> ElementoQuadra [dir=both, arrowtail=odiamond, arrowhead=none, color="#40384F", penwidth=1.5, arrowsize=0.9, label="elementos", taillabel="0..1", headlabel="0..*"];
DadosPrancheta -> Tatica [style=dashed, arrowhead=open, color="#7B718C", penwidth=1.1, arrowsize=0.9, label="carrega / salva"];
DadosPrancheta -> ConexaoBD [style=dashed, arrowhead=open, color="#7B718C", penwidth=1.1, arrowsize=0.9];
Tatica -> QuadroTatica [dir=both, arrowtail=diamond, arrowhead=none, color="#40384F", penwidth=1.5, arrowsize=0.9, label="quadros", taillabel="1", headlabel="1..*"];
QuadroTatica -> AtletaQuadro [dir=both, arrowtail=diamond, arrowhead=none, color="#40384F", penwidth=1.5, arrowsize=0.9, label="atletas", taillabel="1", headlabel="0..*"];
QuadroTatica -> PosicaoBola [dir=both, arrowtail=diamond, arrowhead=none, color="#40384F", penwidth=1.5, arrowsize=0.9, label="bola", taillabel="1", headlabel="0..1"];
AtletaQuadro -> ElementoQuadra [arrowhead=empty, color="#49385E", penwidth=1.6, arrowsize=0.9, constraint=false];
PosicaoBola -> ElementoQuadra [arrowhead=empty, color="#49385E", penwidth=1.6, arrowsize=0.9, constraint=false];
AtletaQuadro -> LadoAtleta [style=dashed, arrowhead=open, color="#7B718C", penwidth=1.1, arrowsize=0.9];
}
